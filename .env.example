# DVConf Daemons — Environment Variables
# Copy to .env and fill in values

# Sui network: localnet | testnet | devnet
SUI_NETWORK=localnet

# On-chain object IDs (from deployment)
PACKAGE_ID=0x...
NETWORK_REGISTRY_ID=0x...
MINER_STORE_ID=0x...
CP_REGISTRY_ID=0x...
RELAY_REGISTRY_ID=0x...
VALIDATOR_REGISTRY_ID=0x...
USER_REGISTRY_ID=0x...
ROOM_MANAGER_ID=0x...

# Daemon wallet secret key (bech32 format, starts with 'suiprivkey')
DAEMON_SECRET_KEY=suiprivkey...

# Logging
LOG_LEVEL=info

# Daemon intervals (milliseconds)
HEARTBEAT_INTERVAL_MS=30000
EVENT_POLL_INTERVAL_MS=3000
