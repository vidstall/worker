# DVConf Daemons — Environment Variables
# Copy to .env and fill in values

# Sui network: localnet | testnet | devnet
SUI_NETWORK=localnet

# On-chain object IDs (from deployment)
PACKAGE_ID=0x...
NETWORK_REGISTRY_ID=0x...
MINER_STORE_ID=0x...
CP_REGISTRY_ID=0x...
RELAY_REGISTRY_ID=0x...
VALIDATOR_REGISTRY_ID=0x...
USER_REGISTRY_ID=0x...
ROOM_MANAGER_ID=0x...
ROLE_VOTE_BOX_ID=0x...

# CP daemon wallet (bech32 format, starts with 'suiprivkey')
CP_KEYPAIR=suiprivkey...

# Validator daemon wallet (bech32 format, starts with 'suiprivkey')
SUI_PRIVATE_KEY=suiprivkey...

# Logging (P17 M1 / F63)
LOG_LEVEL=info
# LOG_PRETTY: 'true' forces pino-pretty, 'false' forces JSON. When unset, dev
# heuristic applies (NODE_ENV=development or LOG_LEVEL=debug/trace => pretty).
# LOG_PRETTY=false
# LOG_OUTPUT: 'stdout' (default) or 'file:/abs/path.log' for JSON-to-file.
# LOG_OUTPUT=stdout

# Liveness endpoints (P17 M1 / F65) — always-on, cheap GET /healthz per daemon.
CP_HEALTHZ_PORT=8091
VALIDATOR_HEALTHZ_PORT=8101
# relay serves /healthz from its existing METRICS_PORT (default 4001).

# Daemon intervals (milliseconds)
HEARTBEAT_INTERVAL_MS=30000
EVENT_POLL_INTERVAL_MS=3000

# Room assignment (populated by room assignment in v2; default: 'unassigned')
ROOM_ID=
