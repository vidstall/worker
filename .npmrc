# The runtime stage of every apps/*/Dockerfile only copies the workspace
# root's node_modules (COPY --from=deps /app/node_modules ./node_modules),
# then overwrites apps/ and packages/ with a fresh host-context copy that
# has no node_modules of its own. pnpm's default node-linker=isolated puts
# each workspace member's dependency symlinks inside that member's own
# node_modules (e.g. apps/relay/node_modules/dotenv), which the runtime
# stage never carries over -- every per-app dependency becomes unresolvable
# at runtime (ERR_MODULE_NOT_FOUND) even though it's correctly declared.
# shamefully-hoist hoists every dependency to the single root node_modules
# instead, matching what the Dockerfiles actually copy.
shamefully-hoist=true
