# ── DVConf Signaling Daemon — Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values before running the daemon.
# NEVER commit .env with real private keys to version control.

# ── Sui Keypair ───────────────────────────────────────────────────────────────
# Ed25519 secret key in bech32 format (starts with "suiprivkey")
# Generate with: sui keytool generate ed25519
SIGNALING_KEYPAIR=

# ── Sui Network ───────────────────────────────────────────────────────────────
# Network name or custom RPC URL.
# Accepted values: localnet | testnet | devnet | mainnet | <custom-rpc-url>
SUI_NETWORK=localnet

# ── DVConf Package & Shared Object IDs ───────────────────────────────────────
# Obtained from `sui client publish` output or .env.testnet after deployment.
PACKAGE_ID=
NETWORK_REGISTRY_ID=
MINER_STORE_ID=
CP_REGISTRY_ID=
RELAY_REGISTRY_ID=
VALIDATOR_REGISTRY_ID=
USER_REGISTRY_ID=
ROOM_MANAGER_ID=
SIGNALING_REGISTRY_ID=

# ── Signaling Registration (optional — skip auto-registration on next startup) ─
# Set to the MinerCap object ID after first successful registration.
# If left empty, the daemon auto-registers on startup (requires 0.05 SUI balance).
MINER_CAP_ID=

# ── WebSocket Server ──────────────────────────────────────────────────────────
# Port the WebSocket server listens on.
SIGNALING_PORT=8080

# Public WebSocket URL advertised on-chain in SignalingRegistry.
# Clients use this URL to connect. Must be reachable from the public internet.
ENDPOINT_URL=ws://127.0.0.1:8080

# ── Region ────────────────────────────────────────────────────────────────────
# Geographic region string used by the Control Plane for relay/signaling scoring.
# Examples: us-east, eu-west, ap-southeast
REGION=local

# ── Daemon Tuning ─────────────────────────────────────────────────────────────
# How often the daemon sends a heartbeat to SignalingRegistry (milliseconds).
HEARTBEAT_INTERVAL_MS=30000
