# ── DVConf Control Plane Daemon — Environment Variables ──────────────────────
# Copy this file to .env and fill in the values before running the daemon.
# NEVER commit .env with real private keys to version control.

# ── Sui Keypair ───────────────────────────────────────────────────────────────
# Ed25519 secret key in bech32 format (starts with "suiprivkey")
# Generate with: sui keytool generate ed25519
CP_KEYPAIR=

# ── Sui Network ───────────────────────────────────────────────────────────────
# Network name or custom RPC URL.
# Accepted values: localnet | testnet | devnet | mainnet | <custom-rpc-url>
SUI_NETWORK=localnet

# ── DVConf Package & Shared Object IDs ───────────────────────────────────────
# Obtained from `sui client publish` output or .env.testnet after deployment.
PACKAGE_ID=
NETWORK_REGISTRY_ID=
MINER_STORE_ID=
CP_REGISTRY_ID=
RELAY_REGISTRY_ID=
VALIDATOR_REGISTRY_ID=
USER_REGISTRY_ID=
ROOM_MANAGER_ID=
SIGNALING_REGISTRY_ID=

# ── CP Registration (optional — skip auto-registration on next startup) ───────
# Set to the ControlPlaneCap object ID after first successful registration.
# If left empty, the daemon auto-registers on startup (requires SUI balance).
CP_CAP_ID=

# ── Daemon Tuning ─────────────────────────────────────────────────────────────
# How often the daemon sends a heartbeat to ControlPlaneRegistry (milliseconds).
HEARTBEAT_INTERVAL_MS=30000

# How often the daemon polls chain events (milliseconds).
POLL_INTERVAL_MS=5000
