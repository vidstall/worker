# DVConf Client Environment Variables
# Copy this file to .env and fill in your values.
# For testnet, copy to .env.testnet and run: pnpm dev -- --mode testnet

# Sui package ID (deployed Move package)
VITE_PACKAGE_ID=0x...

# Shared object IDs from deployment
VITE_NETWORK_REGISTRY_ID=0x...
VITE_USER_REGISTRY_ID=0x...
VITE_ROOM_MANAGER_ID=0x...

# Signaling server WebSocket URL
VITE_SIGNALING_URL=ws://localhost:8080

# Sui network: localnet | testnet
VITE_SUI_NETWORK=localnet
