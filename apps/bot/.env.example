# ── DVConf Bot Daemon — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values before running the daemon.
# NEVER commit .env with real private keys to version control.

# ── Sui Keypair ───────────────────────────────────────────────────────────────
# Ed25519 secret key in bech32 format (starts with "suiprivkey"). Must be
# funded with gas (faucet on localnet/devnet/testnet) before first run.
PRIVATE_KEY=

# ── Sui Network ───────────────────────────────────────────────────────────────
# Network name or custom RPC URL.
# Accepted values: localnet | testnet | devnet | mainnet | <custom-rpc-url>
SUI_NETWORK=localnet

# ── DVConf Package & Shared Object IDs ───────────────────────────────────────
# Obtained from `sui client publish` output or .env.testnet after deployment.
PACKAGE_ID=
NETWORK_REGISTRY_ID=
MINER_STORE_ID=
CP_REGISTRY_ID=
RELAY_REGISTRY_ID=
VALIDATOR_REGISTRY_ID=
USER_REGISTRY_ID=
ROOM_MANAGER_ID=
SIGNALING_REGISTRY_ID=
ROLE_VOTE_BOX_ID=

# ── Bot-specific ──────────────────────────────────────────────────────────────
# Path to the MP4 file the bot loops as its published video/audio.
MP4_PATH=/path/to/loop.mp4

# Room admission password (relay-layer, SHA256-hashed, set by first joiner —
# the bot is always the first joiner since it creates the room). Default "123".
ROOM_PASSWORD=123

# expected_participants passed to room_manager::create_room.
EXPECTED_PARTICIPANTS=4

# The relay's WS URL. Static — the bot joins exactly one relay for one demo
# room; it does not use the client's on-chain relay-discovery machinery.
# cp-daemon must be running so the on-chain RoomCreated event triggers
# automatic relay/signaling assignment for this room.
RELAY_URL=ws://localhost:4000

# Base URL of the client webapp, used to build the shareable join link
# printed at startup: {CLIENT_URL}/rooms/{roomId}?pw={ROOM_PASSWORD}
CLIENT_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
