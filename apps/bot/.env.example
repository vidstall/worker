# ── DVConf Bot Daemon — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values before running the daemon.
# NEVER commit .env with real private keys to version control.

# ── Sui Keypair ───────────────────────────────────────────────────────────────
# Ed25519 secret key in bech32 format (starts with "suiprivkey"). Must be
# funded with gas (faucet on localnet/devnet/testnet) before first run.
PRIVATE_KEY=

# ── Sui Network ───────────────────────────────────────────────────────────────
# Network name or custom RPC URL.
# Accepted values: localnet | testnet | devnet | mainnet | <custom-rpc-url>
SUI_NETWORK=localnet

# ── DVConf Package & Shared Object IDs ───────────────────────────────────────
# Obtained from `sui client publish` output or .env.testnet after deployment.
PACKAGE_ID=
NETWORK_REGISTRY_ID=
MINER_STORE_ID=
CP_REGISTRY_ID=
RELAY_REGISTRY_ID=
VALIDATOR_REGISTRY_ID=
USER_REGISTRY_ID=
ROOM_MANAGER_ID=
ROLE_VOTE_BOX_ID=

# ── Bot-specific (session defaults — a POST /bots request may override these) ─
# Path to the MP4 file the bot loops as its published video/audio. Optional —
# defaults to the sample video baked into the image (apps/bot/assets/001.mp4).
# Set this to point at a different file for local dev.
MP4_PATH=

# Room admission password (relay-layer, SHA256-hashed, set by first joiner —
# the bot is always the first joiner since it creates the room). Default "123".
ROOM_PASSWORD=123

# expected_participants passed to room_manager::create_room (used only when a
# session's roomMode is "create").
EXPECTED_PARTICIPANTS=4

# Base URL of the client webapp, used to build each session's shareable join
# link: {CLIENT_URL}/rooms/{roomId}?pw={ROOM_PASSWORD}
CLIENT_URL=http://localhost:5173

# ── Control server ─────────────────────────────────────────────────────────────
# HTTP port for the bot control API (GET /healthz, POST /bots, GET /bots,
# DELETE /bots/:id). cp-daemon=8091, validator=8101, relay=4000/4001,
# signaling=8080/8082 are already taken.
PORT=8095

# Bearer token required on /bots* routes (Authorization: Bearer <token>).
# NOTE: no relay endpoint is configured here anymore — each session resolves
# its room's REAL relay endpoint on-chain (room_manager::get_room_assignment
# cross-referenced against relay_registry::get_active_relays), since the
# topology has multiple relays and a single static URL would usually be
# wrong. cp-daemon must be running so a newly-created room's RoomCreated
# event triggers automatic relay/signaling assignment.
# Leave unset for local dev — the control API is then UNAUTHENTICATED (a loud
# warning is logged at startup). Set this in any shared/production deployment.
BOT_CONTROL_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
