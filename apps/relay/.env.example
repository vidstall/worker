# ── DVConf Relay Daemon — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in the values before running the daemon.
# NEVER commit .env with real private keys to version control.

# ── Sui Keypair ───────────────────────────────────────────────────────────────
# Ed25519 secret key in bech32 format (starts with "suiprivkey")
# Generate with: sui keytool generate ed25519
PRIVATE_KEY=

# ── Sui Network ───────────────────────────────────────────────────────────────
# Network name or custom RPC URL.
# Accepted values: localnet | testnet | devnet | mainnet | <custom-rpc-url>
SUI_NETWORK=localnet

# ── DVConf Package & Shared Object IDs ───────────────────────────────────────
# Obtained from `sui client publish` output or .env.testnet after deployment.
PACKAGE_ID=
NETWORK_REGISTRY_ID=
MINER_STORE_ID=
CP_REGISTRY_ID=
RELAY_REGISTRY_ID=
VALIDATOR_REGISTRY_ID=
USER_REGISTRY_ID=
ROOM_MANAGER_ID=
SIGNALING_REGISTRY_ID=

# ── Relay Registration (optional — skip auto-registration on next startup) ─────
# Set to the MinerCap object ID after first successful registration.
# If left empty, the daemon auto-registers on startup (requires 0.25 SUI balance).
MINER_CAP_ID=

# ── WebSocket Signaling Server ────────────────────────────────────────────────
# Port the mediasoup WebSocket signaling server listens on.
WS_PORT=4000

# Public WebSocket URL advertised on-chain in RelayRegistry.
# Clients use this URL to connect. Must be reachable from the public internet.
RELAY_ENDPOINT_URL=ws://127.0.0.1:4000

# ── Region ────────────────────────────────────────────────────────────────────
# Geographic region string used by the Control Plane for relay scoring.
# Examples: us-east, eu-west, ap-southeast
REGION=local

# ── Relay Mode ────────────────────────────────────────────────────────────────
# Whether this node runs as SFU (fan-out, no transcoding) or MCU (mixing).
# Accepted values: sfu | mcu
# Default: sfu. One mode per room — no hybrid.
RELAY_MODE=sfu

# ── mediasoup Workers ─────────────────────────────────────────────────────────
# Number of mediasoup Worker processes (default: number of CPU cores).
NUM_WORKERS=

# UDP/TCP port range allocated to mediasoup Workers for WebRTC media.
# Ensure these ports are open in your firewall.
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# Publicly-routable IP that mediasoup announces for WebRTC + inter-relay pipe
# transports (the address remote peers / the paired relay connect back to).
# Default 127.0.0.1 works for a single-host / local / bench run; a multi-host or
# multi-container deploy MUST set this to the host's reachable IP (paired with
# RELAY_ENDPOINT_URL for the WS endpoint) or media silently loopback-fails.
ANNOUNCED_IP=127.0.0.1

# ── Inter-relay warm-pipe link (G3.2b) ────────────────────────────────────────
# Shared secret for the cross-daemon inter-relay WS link. The STANDBY presents it
# as `Authorization: Bearer <token>`; the PRIMARY's signaling server validates it
# (timingSafeEqual) and only a tagged inter-relay peer may inject pipe-producer
# announces. LEAVE EMPTY on a single-host / local / bench run (the dispatch gate
# is then open). A MULTI-HOST deploy MUST set the SAME token on every relay (paired
# with RELAY_ENDPOINT_URL + ANNOUNCED_IP) or the standby's link is dropped.
# SECURITY: on a multi-host deploy, run the inter-relay link over TLS (a wss:// URL
# in RELAY_ENDPOINT_URL behind a TLS-terminating proxy) — the Bearer token rides in
# the WS upgrade header and would otherwise travel in cleartext on the wire.
INTER_RELAY_TOKEN=

# UDP port range for the inter-relay PlainTransport pipe (format "min-max").
# The standby uses <min> for its warm-pipe transport. Default 40000-40100.
PIPE_PORT_RANGE=40000-40100

# How long (ms) before the standby re-dials a dropped inter-relay link. Default 3000.
INTER_RELAY_RECONNECT_MS=3000

# ── Metrics HTTP Server ───────────────────────────────────────────────────────
# Port for the metrics HTTP server (GET /metrics, GET /metrics/:roomId).
# Validators probe this endpoint for relay health measurements.
METRICS_PORT=4001

# Bearer-token guard for GET /metrics and GET /metrics/:roomId (REQ-MCS-007).
# When unset (empty), the gate is OPEN — backward-compatible; the validator's
# fetchRelayMetrics call (RO-019) works without auth (existing behaviour).
# When set to a non-empty secret, callers must send:
#   Authorization: Bearer <your-secret-here>
# /healthz and /api/probe are ALWAYS unauthenticated (RO-020 invariant).
# DEPLOYMENT NOTE: if exposing the metrics port over a public network, also
# run it behind a TLS-terminating reverse proxy (e.g. Traefik) so the Bearer
# token travels encrypted — DA-6. A single-host / bench run can leave this unset.
METRICS_AUTH_TOKEN=

# ── Daemon Tuning ─────────────────────────────────────────────────────────────
# How often the daemon sends a heartbeat to RelayRegistry (milliseconds).
HEARTBEAT_INTERVAL_MS=30000

# ── W5 M1 BWE Backstop (REQ-MCS-005) ─────────────────────────────────────────
# Server-side downlink cap applied on each receive transport via
# recvTransport.setMaxIncomingBitrate(cap). Prevents a client from requesting
# high simulcast layers for every tile and saturating its downlink.
# Value in bits per second. Set to 0 to disable (opt-out).
# PLACEHOLDER — tuned at the P9 bench. Default ~4 Mbps is a starting floor for
# a 9-tile gallery (720p active-speaker + 360p/180p thumbnails).
RELAY_MAX_INCOMING_BITRATE=4000000

# ── F61 Self-Degradation Health Monitor (P17 M2a, DOH-016/017) ────────────────
# Optional per-signal degraded/unhealthy thresholds for the F61 HealthMonitor.
# Values shown are the code defaults (PLACEHOLDERS, OQ-DOH-3 / Phase-2 bench) — set
# to override. worker_cpu = MAX CPU % across live mediasoup workers; packet_loss in
# basis points; worker_died = 'died' events in the rolling window.
RELAY_DEGRADED_WORKER_CPU=70
RELAY_UNHEALTHY_WORKER_CPU=90
RELAY_DEGRADED_PACKET_LOSS=500
RELAY_UNHEALTHY_PACKET_LOSS=1000
RELAY_DEGRADED_WORKER_DIED=1
RELAY_UNHEALTHY_WORKER_DIED=2
# Per-level re-report suppression window (ms). A DISTINCT level always reports
# (escalation/recovery never delayed); the SAME level is debounced within this
# window. Default 60000.
DEGRADATION_COOLDOWN_MS=60000
