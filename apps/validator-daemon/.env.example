# ── DVConf Validator Daemon — Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values before running the daemon.
# NEVER commit .env with real private keys to version control.
#
# SECURITY NOTE: The session wallet (B) is generated fresh on every startup
# and is NEVER persisted to disk or to this file. Only the main wallet key
# (SUI_PRIVATE_KEY) is configured here.

# ── Sui Keypair (main / public validator identity) ────────────────────────────
# Ed25519 secret key in bech32 format (starts with "suiprivkey")
# Generate with: sui keytool generate ed25519
SUI_PRIVATE_KEY=

# ── Sui Network ───────────────────────────────────────────────────────────────
# Network name or custom RPC URL.
# Accepted values: localnet | testnet | devnet | mainnet | <custom-rpc-url>
SUI_NETWORK=localnet

# ── DVConf Package & Shared Object IDs ───────────────────────────────────────
# Obtained from `sui client publish` output or .env.testnet after deployment.
PACKAGE_ID=
NETWORK_REGISTRY_ID=
MINER_STORE_ID=
CP_REGISTRY_ID=
RELAY_REGISTRY_ID=
VALIDATOR_REGISTRY_ID=
USER_REGISTRY_ID=
ROOM_MANAGER_ID=
SIGNALING_REGISTRY_ID=

# ── Validator Registration (optional — skip auto-registration on next startup) ─
# Set to the MinerCap object ID after first successful registration.
# If left empty, the daemon auto-registers on startup (requires 0.1 SUI balance).
VALIDATOR_CAP_ID=

# ── Measurement Tuning ────────────────────────────────────────────────────────
# How often the daemon collects relay metrics and submits a SessionProof (ms).
MEASUREMENT_INTERVAL_MS=60000

# ── Relay Metrics Endpoint (optional) ────────────────────────────────────────
# HTTP URL of the relay daemon's metrics server (GET /metrics/:roomId).
# If set, the validator fetches real unique_peers counts instead of using 0.
# Example: http://127.0.0.1:4001
RELAY_METRICS_URL=

# ── Fallback Room ID (optional) ───────────────────────────────────────────────
# Used only when no rooms are discovered via on-chain events.
# Leave empty in production — the daemon discovers rooms via RoomCreated events.
ROOM_ID=

# ── Fallback Relay Stake ID (optional) ────────────────────────────────────────
# Relay's StakePosition object ID for reward distribution.
# In production this is discovered dynamically via RoomAssigned events.
RELAY_STAKE_ID=

# ── F61 Self-Degradation Health Monitor (P17 M2a, DOH-016/017) ────────────────
# Optional per-signal degraded/unhealthy thresholds for the F61 HealthMonitor.
# Values shown are the code defaults (PLACEHOLDERS, OQ-DOH-3 / Phase-2 bench) — set
# to override. rtt = rolling-avg probe RTT (ms); unreachable = consecutive
# unreachable probe cycles (resets on any reachable).
VALIDATOR_DEGRADED_RTT=300
VALIDATOR_UNHEALTHY_RTT=500
VALIDATOR_DEGRADED_UNREACHABLE=1
VALIDATOR_UNHEALTHY_UNREACHABLE=3
# Per-level re-report suppression window (ms). A DISTINCT level always reports
# (escalation/recovery never delayed); the SAME level is debounced within this
# window. Default 60000.
DEGRADATION_COOLDOWN_MS=60000

# ── Canary Forwarding-Audit (validate-node Wave) ──────────────────────────────
# How often the canary cell-rotation loop re-derives per-relay coverage (ms).
# Also the cadence at which live validator discovery (REQ-CFA-019/020) refreshes.
CANARY_CELL_INTERVAL_MS=300000

# REQ-CFA-022 / D-CFA-19 — the out-of-band covert canary cell secret (HEX), distributed
# over the Wallet-B channel (the SAME secret material the canary keying module consumes,
# D-CFA-10). The validator-held assignmentSecret folded into the cell-assignment score is
# DERIVED (domain-separated) from this, so a relay cannot recompute its own coverage. The
# canary cell loop + coverage feed DO NOT START without it (fail-safe: an unsalted, relay-
# recomputable assignment is refused). Leave empty to keep the canary loop off.
# Example (32 bytes hex): openssl rand -hex 32
CANARY_CELL_SECRET=

# REQ-CFA-013/015 / D-CFA-12/18 — port for the off-chain coverage feed
# (GET /canary/coverage). The server binds LOOPBACK 127.0.0.1 ONLY (unreachable by a
# remote relay) and restricts CORS to the dashboard origin (NEVER `*`). Default 8102
# (distinct from VALIDATOR_HEALTHZ_PORT 8101).
VALIDATOR_CANARY_COVERAGE_PORT=8102

# REQ-CFA-013 / D-CFA-18 — the dashboard origin allowed to read the coverage feed
# cross-origin (restricted CORS, NOT `*`). Default http://localhost:5173 (dev dashboard).
CANARY_COVERAGE_CORS_ORIGIN=http://localhost:5173
