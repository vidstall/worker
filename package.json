{
  "name": "dvconf-daemons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:relay": "vitest run --config vitest.relay-integration.config.ts",
    "test:demo:revote": "vitest run --config vitest.demo.config.ts",
    "bench:m2": "vitest run --config vitest.m2-bench.config.ts && tsx scripts/bench/report-m2-bench.ts",
    "bench:rms": "RMS_BENCH=1 SAT_BENCH=1 vitest run --config vitest.rms-bench.config.ts && tsx scripts/bench/report-rms-bench.ts",
    "bench:p10:browser": "tsx scripts/bench/p10-browser/p10-relayblind-browser.ts",
    "build": "pnpm -r run build",
    "dev:signaling": "pnpm --filter @dvconf/signaling dev",
    "dev:cp": "pnpm --filter @dvconf/cp-daemon dev",
    "dev:validator": "pnpm --filter @dvconf/validator-daemon dev",
    "dev:relay": "pnpm --filter relay dev",
    "dev:client": "pnpm --filter @dvconf/client dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "load-test": "tsx scripts/load-test.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "stress:smoke": "tsx scripts/stress/signaling-stress.ts --scenario smoke --peers 3 --duration 10",
    "stress:s1": "tsx scripts/stress/signaling-stress.ts --scenario s1",
    "stress:s3": "tsx scripts/stress/signaling-stress.ts --scenario s3",
    "bench:replay": "tsx scripts/bench/replay.ts",
    "bench:harness": "tsx scripts/bench/mediasoup-client-harness.ts",
    "bench:smoke": "tsx scripts/bench/run-smoke.ts --peers 2 --runs 5 --duration 60",
    "forensic": "tsx apps/forensic-cli/src/index.ts",
    "forensic:smoke": "tsx apps/forensic-cli/src/index.ts smoke",
    "forensic:collect": "tsx apps/forensic-cli/src/index.ts collect",
    "forensic:report": "tsx apps/forensic-cli/src/index.ts report",
    "failover:smoke": "tsx scripts/failover/failover-smoke.ts"
  },
  "devDependencies": {
    "@mysten/sui": "^1.45.2",
    "@roamhq/wrtc": "^0.10.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "mediasoup": "3.19.17",
    "mediasoup-client": "^3.20.0",
    "playwright": "^1.61.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
